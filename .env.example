# Local development runs without keys: PGlite under ./data, magic links in
# data/auth/outbox.jsonl, and empty match lists. Production needs every
# setting outside the "Optional" block.

# Postgres with pgvector (Neon, Supabase...). Absent: PGlite in-process under
# ./data/pglite (in-memory under test). Production applies migrations with
# `npm run db:migrate`; nothing migrates on connect in production.
DATABASE_URL=

# Required for production sign-in: the exact public HTTPS origin, no path, and
# a stable secret of at least 32 characters. Development defaults to
# localhost:3000 and an ephemeral secret; a restart invalidates sessions.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Google sign-in. An OAuth client from console.cloud.google.com with
# <BETTER_AUTH_URL>/api/auth/callback/google as an authorized redirect URI.
# Production needs this or email delivery below; both may be on.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Verified sender and Resend key for the magic-link form, invitations and
# the digest. Both or neither. Without them development writes to
# data/auth/outbox.jsonl; production hides the email form and the digest
# cron skips delivery.
AUTH_EMAIL_FROM=
RESEND_API_KEY=

# Comma-separated verified emails that may open the cohort map and manage
# membership. Operator status does not by itself grant membership.
PILOT_OPERATOR_EMAILS=

# Voyage embeddings. This is what makes matching real. Absent: cards are
# filed without vectors, nothing throws, and every match list is empty and
# says so. Rows are embedded on the next import once a key exists.
VOYAGE_API_KEY=
# Its dimension must match the embedding columns; src/harness/embed.ts throws
# on load if it does not.
EMBEDDING_MODEL=voyage-3.5

# Bearer token Vercel sends to the digest cron route. Any long random string.
CRON_SECRET=

# --- Optional ----------------------------------------------------------------

# Isolated local PGlite directory, relative to this app.
THESIS_DATA_DIR=

# Corpus ingest (`npm run lodestone:ingest`). A contact address OpenAlex
# requests carry beside the key.
OPENALEX_MAILTO=
# A free PatentsView key, sent as X-Api-Key. Required for --source patents.
PATENTSVIEW_API_KEY=
# A free OpenAlex key (openalex.org/settings/api), sent as api_key on every
# request. It buys its own $1/day budget and 25 requests a second. Without it
# a run shares the keyless $0.10/day budget at 10 a second, and a query stops
# after its first page of 200: OpenAlex refuses cursor paging without a key.
OPENALEX_API_KEY=
