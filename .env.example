# Local development can run without keys. Production requires auth and email settings.

# Anthropic API key for live API turns. Manual editing needs no model key.
ANTHROPIC_API_KEY=

# Postgres with pgvector (Neon, Vercel Postgres, Supabase...). Absent: PGlite
# in-process, stored under ./data/pglite (in-memory under test).
DATABASE_URL=

# Optional isolated local database directory, relative to this app.
THESIS_DATA_DIR=

# Required for production sign-in. Development defaults to localhost:3000
# and an ephemeral secret; restart invalidates development sessions.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Resend delivery uses RESEND_API_KEY below. Without delivery configuration,
# development messages go to data/auth/outbox.jsonl; production fails closed.
AUTH_EMAIL_FROM=
# Comma-separated verified emails allowed to manage this deployment's pilot.
# Operator status does not grant membership or curator access.
PILOT_OPERATOR_EMAILS=
# Comma-separated verified emails permitted to curate research records.
RESOURCE_CURATOR_EMAILS=

# Model and effort for the stage engine.
THESIS_MODEL=claude-opus-5
THESIS_EFFORT=medium

# Phase 3. Off unless exactly "1".
MATCHING_ENABLED=

# Which model implementation runs a turn. Default: "api" when a key is set,
# "cli" (the Claude Code CLI, key-free, your own login) otherwise.
THESIS_ENGINE=

# --- Harness ----------------------------------------------------------------
# Every key either track needs, claimed here so neither has to add one.

# Voyage embeddings. Absent: assertions are written with a null vector and
# the run records `stats.embedded = false`; nothing throws and the rows are
# embedded on the next call once a key exists.
VOYAGE_API_KEY=

# The embedding model. Its dimension must match `assertions.embedding`, and
# `src/harness/embed.ts` throws on load if it does not.
EMBEDDING_MODEL=voyage-3.5

# The harness reader — the instructor reading the papers — as a `person` row,
# created on first use. One identity scheme for students and the harness.
HARNESS_READER_EMAIL=
HARNESS_READER_NAME=

# OpenAlex asks for a contact address in the polite pool; without it requests
# are rate-limited harder.
OPENALEX_MAILTO=

# Legacy harness delivery setting; founder introductions are now in-app only.
HARNESS_INTRO_FROM=
# Also used with AUTH_EMAIL_FROM for verified sign-in email delivery.
RESEND_API_KEY=

# The model that writes a rerank card. Both tracks read it.
HARNESS_RERANK_MODEL=claude-sonnet-5
